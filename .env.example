# ---------------------------------------------------------------------------
# Abidewell — secrets. Copy to your host's Environment Variables screen.
# NEVER commit real values. This file is only a template.
# ---------------------------------------------------------------------------

# The passphrase your sister types on /admin. Make it long and easy to type.
ADMIN_PASSWORD=three-warm-words-and-a-number-42

# Fine-grained GitHub token with "Contents: Read and write" on this one repo.
GITHUB_TOKEN=github_pat_replace_me

# Where the repo lives.
GITHUB_OWNER=your-github-username
GITHUB_REPO=abidewell
GITHUB_BRANCH=main

# Path to the verse file inside the repo.
GITHUB_PATH=public/data/verses.json
